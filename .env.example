# ==============================================================================
# LexAgent Legal Intelligence & Sutra Workspace Environment Configuration
# Fully LOCAL, privacy-first legal document intelligence system for Indian Law
# Port Unified: 5986 (Backend Service & API Documentation)
# ==============================================================================

# Server Network & Binding
PORT=5986
APP_PORT=5986
APP_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEMO_MODE=false

# Local Database Configuration (SQLite default; PostgreSQL 16 + pgvector supported)
DATABASE_URL=sqlite:///lexagent.db
DB_URL=sqlite:///lexagent.db

# LLM Configuration (Local OpenAI-compatible endpoint: Ollama, vLLM, LMStudio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# Dense Embedding Configuration (Ollama / BAAI bge-m3)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBEDDING_TIMEOUT=30.0

# Translation Engine Decoupling (indictrans2 | nllb | http | local_llm)
TRANSLATE_ENGINE=local_llm
TRANSLATE_BASE_URL=http://localhost:8088
TRANSLATE_API_KEY=
TRANSLATE_TIMEOUT=30.0

# Voice Brief & Speech Provider Interface (local | vapi | elevenlabs | voiceflow)
# Note: Windows SAPI only installs English (en-US) voices; for Hindi web playback,
# the browser's native Web Speech API (speechSynthesis) is used client-side.
VOICE_PROVIDER=local
VAPI_BASE_URL=https://api.vapi.ai
VAPI_API_KEY=
ELEVENLABS_API_KEY=
VOICEFLOW_BASE_URL=http://localhost:8000
VOICEFLOW_API_KEY=
VOICEFLOW_VOICE_ID=

# Cryptographic Security & Vault Storage (32-byte hex keys for AES-256-GCM & HMAC)
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUDIT_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-token-signing-key-for-local-lexagent-production
ENCRYPTED_STORAGE_DIR=./vault_storage
