# LexAgent Environment Configuration - Phase 1 Foundation
# Fully LOCAL, privacy-first legal document intelligence system

# LLM Configuration (Local OpenAI-compatible endpoint: Ollama, vLLM, LMStudio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct

# Embedding Configuration
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# Database Configuration (PostgreSQL 16 + pgvector)
DB_URL=postgresql+psycopg://lexagent:lexagent_secret@localhost:5432/lexagent_db

# Security & Secrets
# 32-byte hex key for AES-256-GCM encryption at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super-secret-jwt-token-signing-key-for-local-lexagent

# Optional / Default Fallbacks
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
ENCRYPTED_STORAGE_DIR=./vault_storage
